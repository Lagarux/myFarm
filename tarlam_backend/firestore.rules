rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── OYUN VERİSİ ──
    // Tüm yazma işlemleri Workers backend üzerinden geçiyor (game logic orada doğrulanıyor)
    // Service account OAuth2 token'ları request.auth=null döndürdüğünden
    // backend erişimi için bu koleksiyonlar açık tutulmak zorunda
    match /users/{userId}/{document=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if true;
    }

    // ── RATE LIMIT ──
    // Yalnızca Workers backend kullanır
    match /ratelimit/{uid} {
      allow read, write: if true;
    }

    // ── DİĞER HER ŞEY ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
